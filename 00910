垃圾回收新生代 Minor GC 对应的 Cheney 复制算法是如何判断是否保留的

reduce

```jsx
var flat = function(arr, depth) {
    if (depth === 0) return arr.slice()

    return arr.reduce((res, item) => {
        if (Array.isArray(item)) {
            res.push(...flat(item, depth - 1))
        } else {
            res.push(item)
        }
        return res // 别忘记 return 作为下一次起点
    }, [])
}
```