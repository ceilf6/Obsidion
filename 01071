发布-订阅模式：所以 topic 防止重复

![image.png](%E5%B0%9D%E6%96%B0%E5%8A%9F%E8%83%BD/image.png)

```jsx
mkdir -p ~/.claude/hooks

cat > ~/.claude/hooks/claude-notify-ntfy.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

INPUT="$(cat)"
TYPE="$(echo "$INPUT" | jq -r '.notification_type // "unknown"')"
MSG="$(echo "$INPUT" | jq -r '.message // "Claude Code finished or needs attention"')"
CWD="$(echo "$INPUT" | jq -r '.cwd // ""')"

curl -fsS \
  -H "Title: Claude Code: ${TYPE}" \
  -H "Priority: default" \
  -d "${MSG}

${CWD}" \
  "https://ntfy.sh/cc-ceilf6-wjh" >/dev/null
EOF

chmod +x ~/.claude/hooks/claude-notify-ntfy.sh
```

