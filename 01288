        type: String, // 类型必须是字符串
        required: true, // 必传属性
        default: "60", // 默认值
      },
    },
    ```
    

# computed

Vue2 中的计算属性

通过 get 获取原始数据

通过 set 影响原始数据

方法中this永远指向当前vue实例

```jsx
  computed: {
    // 总页数
    totalPageNumber() {
      return Math.ceil(this.total / this.limit);
    },
    // 显示的最小数字
    visibleMin() {
      // 注意得取个 max 去兜底
      return Math.max(1, this.current - Math.floor(this.visibleNumber / 2));
    },
    visibleMax() {
      return Math.min(
        this.totalPageNumber,
        this.visibleMin + this.visibleNumber - 1,
      );
    },
    numbers() {
      const nums = [];
      for (let i = this.visibleMin; i <= this.visibleMax; ++i) {
        nums.push(i);
      }
      return nums;
    },
  },
```

### 计算属性computed 和 方法methods 有什么区别？

方法调用时是作为一个函数，需要 () ，而计算属性使用时是作为属性，只需要名字、不需要 ()

并且方法调用没有缓存，会有多次

![image.png](工程师沉淀/Vue/Vue2/配置/image.png)

> **计算属性computed本质上是包含getter和setter的方法，**当获取计算属性时，**实际上是在调用计算属性的getter方法**。**vue会收集计算属性的依赖**，并**缓存**计算属性的返回结果。只有当依赖变化后才会重新进行计算。

**方法没有缓存**，每次调用方法都会导致重新执行

计算属性的getter和setter参数固定，getter没有参数，setter只有一个参数。而方法的参数不限。

由于有以上的这些区别，因此**计算属性**通常是根据已有数据得到其他数据，并在得到数据的过程中**不建议使用异步、当前时间、随机数等副作用操作，因为只会执行一次（vue收集的依赖只有响应式数据，像时间不算、不会导致re-render）**

实际上，他们最重要的区别是**含义**上的区别。计算属性含义上也是一个数据，可以读取也可以赋值；方法含义上是一个操作，用于处理一些事情。
> 

完整的计算属性书写：

```jsx
computed: {
  propName: {
    get(){
      // getter
    },
    set(val){
      // setter
    }
  }
}
```

只包含getter的计算属性简写：

```jsx
computed: {
  propName(){
    // getter
  }
}
```

# router

配置 Vue 路由

直接传入 VueRouter 实例

router/index.js

```jsx
import Vue from 'vue';
import VueRouter from 'vue-router';

import Home from '../views/Home'
import About from '../views/About'
import Blog from '../views/Blog'
import Message from '../views/Message'

Vue.use(VueRouter); // 使用Vue插件 - Router
// 本质是构造函数
const router = new VueRouter({
    // 插件配置
    routes: [
        { path: "/", component: Home }, // 一个对象就是一条匹配规则
        { path: "/about", component: About },
        { path: "/blog", component: Blog },
        { path: "/message", component: Message },
    ]
})

export default router
```

main.js中（抽离功能，精简main）

```jsx
import router from './router'
```

