# 74,240 搜索二维数组I和II

# 240 不确保下一行开头比上一行全都大

分析

- 每行从左往右单调递增
- 每列从上往下单调递增

得到性质

利用两个方向的单调性

一个元素**从右上**开始 如果小了、那么往下，如果大了、那么往左

```jsx
/**
 * @param {number[][]} matrix
 * @param {number} target
 * @return {boolean}
 */
var searchMatrix = function(matrix, target) {
    const LR = matrix.length
    const LC = matrix[0].length
    let i = 0
    let j = LC-1
    while(i<LR && j>=0){
        if(matrix[i][j]>target)
            j--
        else if(matrix[i][j]<target)
            i++
        else
            return true
    }
    return false
};
```

# 74 保证下一行开头比上一行全都大

判断每行极限

符合的进行二分

```jsx
/**
 * @param {number[][]} matrix
 * @param {number} target
 * @return {boolean}
 */
var searchMatrix = function(matrix, target) {
    const LR = matrix.length
    const LC = matrix[0].length
    for(let i=0;i<LR;i++){
        if(matrix[i][0]<=target && target<=matrix[i][LC-1]){
            let l = 0
            let r = LC-1
            while(l<=r){
                const mid = Math.floor((l+r)/2)
                const cur = matrix[i][mid]
                if(cur<target)
                // 注意：二分的更新是排除 mid 的
                    l = mid + 1
                else if(cur>target)
                    r = mid - 1
                else 
                    return true
            }
            break
        }
    }
    return false
};
```