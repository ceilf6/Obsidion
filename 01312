#### 四、在DUO上触发调用 update/submit

**1.在组件上配置按钮点击回调**
**2.页面上添加生命周期物料**
**3.页面上配置按钮点击时，触发update**
#### 四、在源码物料上触发  update/submit（推荐统一在单个物料中触发）

安装 [<https://npm.example.com/@meishi/common-duo-lifecycle>](<https://npm.example.com/@meishi/common-duo-lifecycle>)
```typescript
import { update } from '@meishi/common-duo-lifecycle';

// ... 合适时机调用 update
update({
  // 需要把组件入参中的 __duo__ 透传给 update 函数
	__duo__: props.__duo__,
})
```

### 五、update/submit 入参说明

```tsx

export interface UpdateOptions extends LifecycleLoadingOptions {
  // update 时携带的数据
  PAYLOAD?: any;
  // debounce 延迟
  debounceDelay?: number;
  // 加锁
  lock?: boolean;
  // 触发 update 的 nodeName
  emitNode?: string;
}

export interface SubmitOptions extends LifecycleLoadingOptions {
  // submit 时携带的数据
  PAYLOAD?: any;
  // 加锁
  lock?: boolean;
  // 触发 submit 的 nodeName
  emitNode?: string;
}

export interface CheckOptions extends LifecycleLoadingOptions {
  // check 时携带的数据
  PAYLOAD?: any;
  // 加锁
  lock?: boolean;
  // 触发 check 的 nodeName
  emitNode?: string;
}

export interface LifecycleLoadingOptions {
  // 是否展示 loading
  isShowLoading?: boolean;
  // 延迟显示 loading
  showLoadingDelay?: number;
  // 至少显示时长，太快会一闪而过。默认 200ms
  loadingMinDuration?: number;
  // 成功后是否关闭 loading。默认 true
  autoCloseLoading?: boolean;
  loadingOptions?: {
    /**
     * @label 是否显示图标
     */
    showIcon?: boolean;
    /**
     * @label 是否显示文案
     */
    showContent?: boolean;
    /**
     * @label 文案
     */
    content?: string;
    /**
     * @label 页面背景颜色类型
     * @desc 用于深背景 or 浅背景
     */
    bgColorType?: 'dark' | 'light';
    /**
     * @label 尺寸
     */
    level?: 'large' | 'small';
  };
}
```

