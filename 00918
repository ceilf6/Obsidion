watch

将目标 组件 的 包 包装到一个页面中方便开发

```jsx
#!/usr/bin/env node

const foodUtils = require('./food-utils');

/**
 * 主程序
 */
async function main() {
  try {
    console.log('🚀 开始执行watch-in-order...');

    // 检查目录是否存在
    const targetPath = await foodUtils.getTargetPath('12413');
    if (!targetPath) {
      console.error('❌ 由于前置检查失败，无法执行命令');
      process.exit(1);
      return;
    }

    console.log('✅ 目标路径存在:', targetPath);

    // 修改duo.config.js文件
    await foodUtils.updateDuoConfig(targetPath);

    // 检查和更新food.config.json
    await foodUtils.checkAndUpdateFoodConfig(targetPath);

    // 删除src目录下的package.json文件
    await foodUtils.deleteComponentPackageJsonFiles(targetPath);

    // 优化materialMap文件中的懒加载组件引用（在复制组件之前执行）
    await foodUtils.optimizeLazyLoadImports(targetPath);

    // 从node_modules复制@meishi/submit-miaoti-container组件到page目录并更新引用
    await foodUtils.copySubmitMiaotiContainer(targetPath);

    // 从node_modules复制@meishi/group-buy-tab组件到page目录并更新引用
    await foodUtils.copyGroupBuyTab(targetPath);

    // 清理_Home目录
    await foodUtils.cleanHomeDirectory(targetPath);

    // 执行food watch max-duo
    await foodUtils.runFoodWatch(targetPath);
  } catch (error) {
    console.error('❌ 程序执行失败:', error);
    process.exit(1);
  }
}

// 如果直接运行脚本，执行主流程
if (require.main === module) {
  main();
} else {
  // 作为模块导出时的接口
  module.exports = {
    main,
  };
}

```

